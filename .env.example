# ============================================================
# .env.example — copie para .env.local e preencha os valores
# NUNCA commite o arquivo .env.local ou qualquer .env real
# ============================================================

# ----- Formulário de Contato (Resend) -----
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# E-mail que receberá as mensagens do formulário de contato
CONTACT_EMAIL_TO=seu-email@exemplo.com

# E-mail remetente (deve estar verificado no Resend ou usar o domínio padrão)
# Se usar o domínio gratuito do Resend: noreply@resend.dev
CONTACT_EMAIL_FROM=noreply@seudominio.com

# ----- Site -----
# URL pública do site (sem barra final) — usado para Open Graph e SEO
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# ----- Opcional: Supabase (apenas se adicionar banco de dados) -----
# Use APENAS a chave anon (pública) no client-side via NEXT_PUBLIC_
# NUNCA exponha a service_role key — mantenha-a só em variável server-side
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  ← SERVER-SIDE ONLY
